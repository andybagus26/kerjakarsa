# ==========================================
# KERJAKARSA ENVIRONMENT CONFIGURATION
# Kompetisi Gemastik XIX (Software Development)
# ==========================================

# 1. SUPABASE DATABASE & REALTIME CONFIG
# Dapatkan dari Supabase Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# 2. GOOGLE GEMINI GENERATIVE AI API KEY
# Dapatkan dari Google AI Studio (https://aistudio.google.com)
GEMINI_API_KEY=your-gemini-api-key

# 3. MIDTRANS PAYMENT GATEWAY API KEYS (SANDBOX / PRODUCTION)
# Dapatkan dari Midtrans Dashboard -> Access Keys (https://dashboard.sandbox.midtrans.com)
MIDTRANS_SERVER_KEY=SB-Mid-server-your-server-key
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY=SB-Mid-client-your-client-key
NEXT_PUBLIC_MIDTRANS_IS_PRODUCTION=false
